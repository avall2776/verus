# ==============================================================================
# CONFIGURAÇÃO GERAL DO SISTEMA VERUS
# ==============================================================================
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ==============================================================================
# BANCO DE DADOS POSTGRESQL (COM PGVECTOR PARA RAG)
# ==============================================================================
DATABASE_URL="postgresql://verus_user:verus_password@localhost:5432/verus_db?schema=public"

# ==============================================================================
# REDIS (FILAS DE MENSAGENS BULLMQ & TRAVA DE HANDOFF)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# AUTENTICAÇÃO E SEGURANÇA (JWT & SESSÕES)
# ==============================================================================
JWT_SECRET=substitua_por_uma_chave_secreta_forte_min_32_caracteres
JWT_EXPIRES_IN=7d

# ==============================================================================
# META CLOUD API (WHATSAPP BUSINESS OFICIAL)
# ==============================================================================
# Obtido em: developers.facebook.com -> Seu App -> WhatsApp -> API Setup
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=verus_webhook_secret_token_123

# ==============================================================================
# OPENAI (MOTOR DE INTELIGÊNCIA ARTIFICIAL & EMBEDDINGS)
# ==============================================================================
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# OBJECT STORAGE (PDFs E MATERIAIS DE TREINAMENTO RAG)
# Compatível com AWS S3, Cloudflare R2 ou MinIO
# ==============================================================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=verus_minio_admin
STORAGE_SECRET_KEY=verus_minio_secret
STORAGE_BUCKET_NAME=verus-knowledge-base
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

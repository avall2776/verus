generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ------------------------------------------------------
// SUPER ADMIN (Dono do SaaS) & TENANTS (Assinantes)
// ------------------------------------------------------

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id           String   @id @default(uuid())
  name         String   // Basic, Pro, Enterprise
  price        Decimal
  hasCRM       Boolean  @default(false)
  hasWhatsApp  Boolean  @default(true)
  hasInstagram Boolean  @default(false)
  hasAIAgent   Boolean  @default(false)
  maxUsers     Int      @default(1)
  maxAIMsgs    Int      @default(0)
  tenants      Tenant[]
}

model Tenant {
  id         String   @id @default(uuid())
  name       String
  cnpj       String?
  isActive   Boolean  @default(true)
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id])
  users      User[]
  contacts     Contact[]
  departments  Department[]
  quickReplies QuickReply[]
  channels     Channel[]
  businessHours BusinessHours[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents  KnowledgeDocument[]
  chunks     DocumentChunk[]

  // Configurações da IA
  aiName          String? 
  aiModel         String  @default("gpt-4o-mini")
  aiPrompt        String?
  aiKnowledgeBase String?
  aiTemperature   Float   @default(0.7)
  
  metaToken         String?
  metaPhoneNumberId String?
}

// ------------------------------------------------------
// USUÁRIOS DO TENANT E CRM
// ------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // ADMIN, AGENT
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  isOnline  Boolean  @default(false)
  departments UserDepartment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// TRIAGEM, FILAS E DEPARTAMENTOS
// ------------------------------------------------------

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   // Ex: Vendas, Suporte
  color     String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  users     UserDepartment[]
  conversations Conversation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDepartment {
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  
  @@id([userId, departmentId])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  source    String   // WhatsApp, Instagram, Web
  tags      String[] // Quente, Frio
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  messages  Message[]
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Conversation {
  id           String   @id @default(uuid())
  tenantId     String
  contactId    String
  departmentId String?
  assignedTo   String?  // ID do Atendente (User)
  status       String   @default("waiting") // waiting, bot_active, human_takeover, open, resolved
  contact      Contact  @relation(fields: [contactId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  messages     Message[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
}

model Message {
  id                String   @id @default(uuid())
  tenantId          String
  conversationId    String
  providerMessageId String?
  content           String
  type              String   @default("text") // text, image, audio, video, document
  mediaUrl          String?
  audioTranscription String?
  isInternal        Boolean  @default(false)
  fromMe            Boolean  @default(false)
  direction         String   @default("INBOUND") // INBOUND, OUTBOUND
  senderType        String   @default("contact") // contact, system, agent
  status            String   @default("delivered")
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([tenantId, providerMessageId])
}

model Deal {
  id        String   @id @default(uuid())
  tenantId  String
  contactId String
  title     String
  value     Decimal  @default(0)
  status    String   @default("new")
  notes     String?
  contact   Contact  @relation(fields: [contactId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

model QuickReply {
  id        String   @id @default(uuid())
  tenantId  String
  shortcut  String   // ex: "/bomdia"
  content   String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, shortcut])
  @@index([tenantId])
}

model Channel {
  id         String   @id @default(uuid())
  tenantId   String
  name       String   // Ex: Suporte WhatsApp
  type       String   // whatsapp, instagram, web
  identifier String   // Ex: 554999999999
  status     String   @default("connected")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([tenantId, identifier])
}

model BusinessHours {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String?  // Opcional: pode ser geral do tenant ou por departamento
  dayOfWeek    Int      // 0 = Domingo, 1 = Segunda, etc.
  startTime    String   // Ex: "08:00"
  endTime      String   // Ex: "18:00"
  isActive     Boolean  @default(true)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  
  @@unique([tenantId, departmentId, dayOfWeek])
}

// ------------------------------------------------------
// RAG (Base de Conhecimento Vetorial)
// ------------------------------------------------------

model KnowledgeDocument {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  filename  String
  fileSize  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks    DocumentChunk[]

  @@index([tenantId])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  content    String
  embedding  Unsupported("vector(1536)")?

  @@index([tenantId])
  @@index([documentId])
}

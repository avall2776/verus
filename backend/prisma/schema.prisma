generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ------------------------------------------------------
// SUPER ADMIN (Dono do SaaS) & TENANTS (Assinantes)
// ------------------------------------------------------

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id           String   @id @default(uuid())
  name         String   // Basic, Pro, Enterprise
  price        Decimal
  hasCRM       Boolean  @default(false)
  hasWhatsApp  Boolean  @default(true)
  hasInstagram Boolean  @default(false)
  hasAIAgent   Boolean  @default(false)
  maxUsers     Int      @default(1)
  maxAIMsgs    Int      @default(0)
  tenants      Tenant[]
}

model Tenant {
  id         String   @id @default(uuid())
  name       String
  cnpj       String?
  logoUrl    String?
  phone      String?
  address    String?
  email      String?
  isActive   Boolean  @default(true)
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id])
  users      User[]
  contacts     Contact[]
  departments  Department[]
  quickReplies QuickReply[]
  automations  Automation[]
  channels     Channel[]
  teamChannels TeamChannel[]
  teamMessages TeamMessage[]
  businessHours BusinessHours[]
  whatsappInstances WhatsAppInstance[]
  proposals    Proposal[]
  goals        Goal[]
  contracts    Contract[]
  emails       EmailMessage[]
  supportTickets SupportTicket[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents  KnowledgeDocument[]
  chunks     DocumentChunk[]

  // Configurações da IA
  aiName          String? 
  aiModel         String  @default("gpt-4o-mini")
  aiPrompt        String?
  aiKnowledgeBase String?
  aiTemperature   Float   @default(0.7)
  
  metaToken         String?
  metaPhoneNumberId String?
  whatsappSettings  Json?    // { antiBanEnabled: boolean, typingDelayMs: number, messageDelayMs: number }
  emailSettings     Json?    // { provider: string, smtpHost?: string, smtpPort?: number, smtpSecure?: boolean, smtpUser?: string, smtpPass?: string, fromName?: string, fromEmail?: string, resendApiKey?: string, isActive?: boolean }
}

// ------------------------------------------------------
// USUÁRIOS DO TENANT E CRM
// ------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // ADMIN, AGENT, SUPER_ADMIN
  isActive  Boolean  @default(true)
  isSuperAdmin Boolean @default(false)
  permissions Json?   // { inbox: boolean, crm: boolean, chat: boolean, automations: boolean, settings: boolean, support: boolean }
  avatarUrl String?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  isOnline  Boolean  @default(false)
  departments UserDepartment[]
  deals     Deal[]
  goals     Goal[]
  sentTeamMessages     TeamMessage[] @relation("SentTeamMessages")
  receivedTeamMessages TeamMessage[] @relation("ReceivedTeamMessages")
  supportTickets       SupportTicket[] @relation("UserSupportTickets")
  assignedTickets      SupportTicket[] @relation("AssignedSupportTickets")
  ticketMessages       TicketMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// TRIAGEM, FILAS E DEPARTAMENTOS
// ------------------------------------------------------

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   // Ex: Vendas, Suporte
  color     String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  users     UserDepartment[]
  conversations Conversation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDepartment {
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  
  @@id([userId, departmentId])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  avatarUrl String?
  source    String   // WhatsApp, Instagram, Web
  tags      String[] // Quente, Frio
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  messages  Message[]
  deals     Deal[]
  proposals Proposal[]
  emails    EmailMessage[]
  automationLogs AutomationLog[]
  supportTickets SupportTicket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Conversation {
  id           String   @id @default(uuid())
  tenantId     String
  contactId    String
  departmentId String?
  assignedTo   String?  // ID do Atendente (User)
  status       String   @default("waiting") // waiting, bot_active, human_takeover, open, resolved
  contact      Contact  @relation(fields: [contactId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  messages     Message[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
  @@unique([tenantId, contactId])
}

model Message {
  id                String   @id @default(uuid())
  tenantId          String
  conversationId    String
  providerMessageId String?
  content           String
  type              String   @default("text") // text, image, audio, video, document
  mediaUrl          String?
  audioTranscription String?
  isInternal        Boolean  @default(false)
  fromMe            Boolean  @default(false)
  direction         String   @default("INBOUND") // INBOUND, OUTBOUND
  senderType        String   @default("contact") // contact, system, agent
  status            String   @default("delivered") // delivered, scheduled, failed, read
  scheduledAt       DateTime?
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, status, scheduledAt])
}

model Deal {
  id        String   @id @default(uuid())
  tenantId  String
  contactId String
  title      String
  value      Decimal  @default(0)
  status     String   @default("new")
  notes      String?
  metadata   Json?
  assignedTo String?
  contact    Contact  @relation(fields: [contactId], references: [id])
  assignee   User?    @relation(fields: [assignedTo], references: [id])
  proposals  Proposal[]
  emails     EmailMessage[]
  automationLogs AutomationLog[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

model QuickReply {
  id        String   @id @default(uuid())
  tenantId  String
  shortcut  String   // ex: "/bomdia"
  content   String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, shortcut])
  @@index([tenantId])
}

model Channel {
  id         String   @id @default(uuid())
  tenantId   String
  name       String   // Ex: Suporte WhatsApp
  type       String   // whatsapp, instagram, web
  identifier String   // Ex: 554999999999
  status     String   @default("connected")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([tenantId, identifier])
}

model BusinessHours {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String?  // Opcional: pode ser geral do tenant ou por departamento
  dayOfWeek    Int      // 0 = Domingo, 1 = Segunda, etc.
  startTime    String   // Ex: "08:00"
  endTime      String   // Ex: "18:00"
  isActive     Boolean  @default(true)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  
  @@unique([tenantId, departmentId, dayOfWeek])
}

// ------------------------------------------------------
// RAG (Base de Conhecimento Vetorial)
// ------------------------------------------------------

model KnowledgeDocument {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  filename  String
  fileSize  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks    DocumentChunk[]

  @@index([tenantId])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  content    String
  embedding  Unsupported("vector(1536)")?

  @@index([tenantId])
  @@index([documentId])
}

// ------------------------------------------------------
// AUTOMAÇÕES (WORKFLOWS)
// ------------------------------------------------------

model Automation {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  description       String?
  triggerType       String   // e.g. "PROPOSAL_ACCEPTED", "DEAL_CREATED", "DEAL_STAGE_CHANGED", "CONTRACT_SIGNED", "MESSAGE_RECEIVED", "TAG_ADDED", "INACTIVITY"
  conditions        Json?    
  triggerConditions Json?    
  actions           Json     // Ex: [{ "type": "SEND_WHATSAPP_MESSAGE", "payload": {} }]
  actionType        String?  // Ex: "SEND_WHATSAPP_MESSAGE", "UPDATE_DEAL_STAGE", "NOTIFY_TEAM", "ADD_TAG"
  actionPayload     Json?    
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logs              AutomationLog[]

  @@index([tenantId])
  @@index([tenantId, triggerType, isActive])
}

model AutomationLog {
  id             String   @id @default(uuid())
  tenantId       String
  automationId   String
  contactId      String?
  dealId         String?
  status         String   @default("SUCCESS") // SUCCESS, FAILED
  error          String?
  errorReason    String?
  payloadDetails Json?
  executedAt     DateTime @default(now())
  
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact        Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([automationId])
}

// ------------------------------------------------------
// CHAT INTERNO DA EQUIPE
// ------------------------------------------------------

model TeamChannel {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages    TeamMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model TeamMessage {
  id         String   @id @default(uuid())
  tenantId   String
  senderId   String
  channelId  String?
  receiverId String?
  content    String   @db.Text
  mediaUrl   String?
  createdAt  DateTime @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender     User         @relation("SentTeamMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User?        @relation("ReceivedTeamMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  channel    TeamChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([channelId])
  @@index([receiverId])
}

// ------------------------------------------------------
// INSTÂNCIAS DE WHATSAPP MULTI-TENANT & HISTÓRICO
// ------------------------------------------------------

model WhatsAppInstance {
  id              String   @id @default(uuid())
  tenantId        String
  name            String   @default("Linha Principal")
  phoneNumber     String?
  profilePicUrl   String?
  profileName     String?
  status          String   @default("disconnected") // connected, disconnected, connecting, qrcode
  qrCode          String?  @db.Text
  token           String?
  phoneNumberId   String?
  isDefault       Boolean  @default(true)
  settings        Json?    // { antiBanEnabled: boolean, typingDelayMs: number, messageDelayMs: number }
  lastConnectedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  history         WhatsAppConnectionHistory[]

  @@index([tenantId])
}

model WhatsAppConnectionHistory {
  id          String   @id @default(uuid())
  instanceId  String
  status      String   // connected, disconnected, error
  details     String?
  timestamp   DateTime @default(now())

  instance    WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
}

// ------------------------------------------------------
// MÓDULOS DE EXPANSÃO COMERCIAL (PROPOSTAS, METAS, CONTRATOS)
// ------------------------------------------------------

model Proposal {
  id            String         @id @default(uuid())
  tenantId      String
  leadId        String?
  dealId        String?
  code          String?
  title         String
  clientName    String?
  clientEmail   String?
  clientPhone   String?
  clientCompany String?
  sellerName    String?
  status        String         @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, etc.
  totalValue    Decimal        @default(0)
  discountTotal Decimal        @default(0)
  paymentTerms  String?
  paymentMethod String?
  validUntil    DateTime?
  acceptedAt    DateTime?
  notes         String?
  items         ProposalItem[]
  contracts     Contract[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead          Contact?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal          Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([leadId])
  @@index([dealId])
}

model ProposalItem {
  id              String   @id @default(uuid())
  proposalId      String
  name            String?
  description     String
  quantity        Int      @default(1)
  unitPrice       Decimal  @default(0)
  discountPercent Decimal? @default(0)
  totalPrice      Decimal  @default(0)
  createdAt       DateTime @default(now())

  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Goal {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String?
  title        String?
  targetType   String    // REVENUE, DEALS, LEADS
  targetValue  Decimal   @default(0)
  currentValue Decimal   @default(0)
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, targetType])
  @@index([userId])
}

model Contract {
  id             String    @id @default(uuid())
  tenantId       String
  proposalId     String?
  code           String?
  title          String    @default("Contrato de Prestação de Serviços")
  clientName     String
  clientEmail    String?
  clientPhone    String?
  clientDocument String?
  clientAddress  String?
  value          Decimal   @default(0)
  status         String    @default("PENDING_SIGNATURE") // PENDING_SIGNATURE, SIGNED, CANCELED
  startDate      DateTime?
  endDate        DateTime?
  validUntil     DateTime?
  documentUrl    String?
  auditLogUrl    String?
  signedAt       DateTime?
  signIp         String?
  signUserAgent  String?
  terms          String?   @db.Text
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposal       Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([proposalId])
}

// ------------------------------------------------------
// INBOX DE E-MAIL UNIFICADO ENTERPRISE
// ------------------------------------------------------

model EmailMessage {
  id             String    @id @default(uuid())
  tenantId       String
  contactId      String?
  dealId         String?
  proposalId     String?
  contractId     String?
  
  threadId       String?
  senderName     String
  senderEmail    String
  recipientEmail String
  recipientName  String?
  cc             String?
  bcc            String?
  
  subject        String
  bodyText       String    @db.Text
  bodyHtml       String?   @db.Text
  preview        String?
  
  folder         String    @default("INBOX") // INBOX, SENT, DRAFT, TRASH, ARCHIVE
  isRead         Boolean   @default(false)
  isStarred      Boolean   @default(false)
  hasAttachments Boolean   @default(false)
  attachments    Json?     // [{ name: string, url: string, size: number, type: string }]
  
  sentAt         DateTime?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId, folder])
  @@index([tenantId, isStarred])
  @@index([tenantId, isRead])
  @@index([tenantId, threadId])
  @@index([contactId])
  @@index([dealId])
}

// ------------------------------------------------------
// CENTRAL DE SUPORTE & ATENDIMENTO (ESTILO LERO)
// ------------------------------------------------------

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber Int            @default(autoincrement())
  subject      String
  description  String         @db.Text
  status       String         @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CLIENT, RESOLVED, CLOSED
  priority     String         @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  category     String         @default("DUVIDA_TECNICA") // FINANCEIRO, DUVIDA_TECNICA, BUG, SOLICITACAO_RECURSO, OUTROS
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?          @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?          @relation("AssignedSupportTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  contactId    String?
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, category])
  @@index([userId])
  @@index([assignedToId])
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName  String?
  senderRole  String        @default("USER") // USER, AGENT, ADMIN, SYSTEM
  content     String        @db.Text
  isInternal  Boolean       @default(false) // Nota interna entre atendentes
  attachments Json?         // [{ name: string, url: string, size?: number, type?: string }]
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@index([senderId])
}


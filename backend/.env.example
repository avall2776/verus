# ==============================================================================
# SUPABASE / PRISMA CONFIGURATION
# ==============================================================================
# O DATABASE_URL usa a porta do Pooler (geralmente porta 6543 no Supabase)
# É ideal para Serverless e concorrência alta. Substitua pelas suas credenciais.
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# O DIRECT_URL usa a porta direta do banco (porta 5432)
# É OBRIGATÓRIO para rodar o 'npx prisma migrate dev' ou push de schema.
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ==============================================================================
# BACKEND CONFIGURATION
# ==============================================================================
NODE_ENV="development"
PORT=3001
APP_URL="http://localhost:3001"
